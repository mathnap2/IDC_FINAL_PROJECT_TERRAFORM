terraform {
  required_version = ">= 1.5"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }
}

# Se autentica con la sesión de `az login`.
provider "azurerm" {
  features {}
  subscription_id = var.subscription_id
}
